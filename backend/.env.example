# Use a pre-created database and a dedicated MySQL user on your host.
# DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=trackmauzo;charset=utf8mb4
# DB_USER=trackmauzo
# DB_PASSWORD=replace-with-your-database-password
# Without DB_DSN the server uses backend/storage/trackmauzo.sqlite.
ALLOWED_ORIGINS=http://localhost:53000
ALLOW_REGISTRATION=true

# NextSMS Gateway Configuration for OTP & Alerts
NEXTSMS_USERNAME=replace-with-your-nextsms-username
NEXTSMS_PASSWORD=replace-with-your-nextsms-password
NEXTSMS_SENDER_ID=POS
NEXTSMS_EMAIL=replace-with-your-nextsms-email
